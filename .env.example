# Chaîne de connexion Neon "pooled" (hôte en -pooler), pour l'application.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Chaîne directe (même hôte sans -pooler), utilisée pour les migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Secret de signature des sessions du back-office (32 caractères minimum).
# Générer : openssl rand -base64 48
SESSION_SECRET=

# URL publique du site (SEO, sitemap, partage).
NEXT_PUBLIC_SITE_URL=https://vpfa.vercel.app
